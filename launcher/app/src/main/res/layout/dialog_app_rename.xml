<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog for renaming an app -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="32dp"
    android:orientation="vertical"
    android:background="@drawable/weather_card_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/rename_app"
        android:textSize="18sp"
        android:fontFamily="@font/outfit_medium"
        android:textColor="#FFFFFFFF"
        android:gravity="center" />

    <EditText
        android:id="@+id/appRenameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:padding="16dp"
        android:inputType="text"
        android:hint="@string/enter_name"
        android:textSize="18sp"
        android:fontFamily="@font/outfit_light"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/settings_choice_bg"
        android:focusable="true"
        android:clickable="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelRename"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true" />

        <Button
            android:id="@+id/btnSaveRename"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/save"
            android:textSize="16sp"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

</LinearLayout>